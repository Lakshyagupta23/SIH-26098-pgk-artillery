# Aegis-155 Environment Variables

# The port the FastAPI application will run on (default 8000)
PORT=8000

# The environment ('development' or 'production')
ENVIRONMENT=development

# Database connection URL (defaults to a local SQLite database)
DATABASE_URL=sqlite:///./aegis155.db

# Required for production authentication. Generate a strong secret key.
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Enable authentication (set to True to require login, False to skip for local dev)
AUTH_ENABLED=False

# Enable demo mode to generate a default 'admin' account automatically
DEMO_MODE=False

# Cesium Ion Access Token (for 3D globe and terrain rendering)
CESIUM_ION_TOKEN=

# Allowed CORS origins, comma-separated (e.g. http://localhost:8000,https://my-frontend.com)
CORS_ORIGINS=*
