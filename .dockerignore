# .dockerignore — Build (8)
# Prevents development artifacts from polluting the Docker build context.
# This is CRITICAL: without this, COPY . . in the Dockerfile would include
# the venv, local DB, secrets, and caches.

# === Python environments (machine-specific, must NOT enter image) ===
venv/
.venv/

# === Python caches ===
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# === Local runtime database (regenerated by app via Alembic on first start) ===
aegis155.db
aegis155.db-journal
*.db

# === Secrets / Environment files ===
# Operators MUST supply these via docker run --env-file or environment injection.
.env

# === Runtime logs ===
*.log
backend*.log

# === Backup and temporary files ===
*.bak
*.backup
*_backup
*.tmp

# === Version control ===
.git/
.gitignore

# === Editor artifacts ===
.vscode/
.idea/
*.swp
*~

# === OS artifacts ===
.DS_Store
Thumbs.db
